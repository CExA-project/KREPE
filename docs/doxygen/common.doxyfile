# Run the capture/replay configuration from the repository root.
OUTPUT_LANGUAGE         = English
QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = YES

# Include public declarations before detailed header documentation is added.
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
EXTRACT_PRIV_VIRTUAL    = NO
EXTRACT_STATIC          = NO
EXTRACT_LOCAL_CLASSES   = NO
INTERNAL_DOCS           = NO
EXCLUDE_SYMBOLS         = krepe::impl \
                          krepe::impl::* \
                          krepe::hdl_utils \
                          krepe::hdl_utils::*

# Parse only the explicitly listed public headers.
RECURSIVE               = NO
ENABLE_PREPROCESSING    = YES
SEARCH_INCLUDES         = NO
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
PREDEFINED              = "KOKKOS_VERSION_LESS(major,minor,patch)=0" \
                          "KOKKOS_VERSION_GREATER_EQUAL(major,minor,patch)=1"
CLANG_ASSISTED_PARSING  = NO

FULL_PATH_NAMES         = NO
STRIP_FROM_INC_PATH     = src

GENERATE_HTML           = NO
GENERATE_LATEX          = NO
GENERATE_XML            = YES
XML_OUTPUT              = xml
XML_PROGRAMLISTING      = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO
GENERATE_DOCBOOK        = NO
HAVE_DOT                = NO
